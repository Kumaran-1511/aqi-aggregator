# ==============================================================================
# AeroWatch Backend Environment Configuration (.env.example)
# Duplicate this file as .env and replace placeholder values with your credentials.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Supports both MONGO_URI and MONGODB_URI)
# For local MongoDB: mongodb://127.0.0.1:27017/aqi_system
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aqi_system?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/aqi_system
MONGODB_URI=mongodb://127.0.0.1:27017/aqi_system

# Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Telemetry Caching & Background Ingestion Schedule
INGESTION_CRON=*/30 * * * *
CACHE_TTL_MINUTES=30

# External Telemetry API Keys (Optional - baseline works out of the box with Open-Meteo)
# Central Pollution Control Board (CPCB) via https://data.gov.in
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
CPCB_DATA_GOV_API_KEY=your_data_gov_in_api_key_here

# OpenAQ v3 REST API (free from https://explore.openaq.org)
OPENAQ_API_KEY=your_openaq_api_key_here

# World Air Quality Index / AQICN API (free from https://aqicn.org/data-platform/token/)
AQICN_API_TOKEN=your_waqi_token_here
WAQI_TOKEN=your_waqi_token_here

# IQAir AirVisual API (free from https://www.iqair.com/air-pollution-data-api)
IQAIR_API_KEY=your_iqair_api_key_here

# SMTP Email Alert Service (Optional - logs locally if not specified)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
ALERT_SENDER_EMAIL=alerts@example.com
