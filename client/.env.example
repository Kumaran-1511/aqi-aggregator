# ==============================================================================
# AeroWatch Frontend Environment Configuration (.env.example)
# Duplicate this file as .env or .env.local for development.
# In production (e.g., Vercel), enter this variable in the Project Settings dashboard.
# ==============================================================================

# Backend API & Socket.io server base URL
# Leave blank for local development to use Vite's built-in dev proxy,
# or set to your deployed Render server URL in production (e.g. https://your-server.onrender.com)
VITE_API_URL=
